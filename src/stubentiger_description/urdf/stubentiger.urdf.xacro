<?xml version="1.0"?>
<!--
  Stubentiger: one model for all three hardware backends. Each track is three floor wheels, the
  middle one commanded and the outer two mimicking it. Values from #24 ("stubentiger_description"),
  relative to base_footprint (the floor point under the middle floor wheels), x forward, y left,
  z up. Collision is primitives; visuals are the CAD meshes where they exist, boxes elsewhere.

  Arguments:
    hardware          gazebo, real or mock: the <ros2_control> backend (stubentiger.ros2_control.xacro).
    controllers_file  the controller YAML that gz_ros2_control loads (gazebo only); empty leaves the
                      plugin out.
    sensors           true adds the sim LiDAR, IMU and camera (stubentiger.sensors.xacro).
    serial_port       the motor controller's serial port (real only).
    counts_per_rev    encoder counts per sprocket turn (real only).
-->
<robot name="stubentiger" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="sensors" default="false"/>
  <xacro:arg name="serial_port" default="/dev/arduino"/>
  <!-- Encoder counts per sprocket turn, 48 per motor turn (#10); calibrated in v0.2.0. -->
  <xacro:arg name="counts_per_rev" default="979.62"/>

  <xacro:property name="hardware" value="$(arg hardware)"/>
  <xacro:if value="${hardware not in ['gazebo', 'real', 'mock']}">
    ${xacro.fatal("hardware must be gazebo, real or mock, not '" + hardware + "'")}
  </xacro:if>

  <xacro:include filename="stubentiger.ros2_control.xacro"/>

  <!-- Geometry, in metres. -->
  <xacro:property name="base_link_z" value="0.027"/>
  <xacro:property name="wheel_radius" value="0.01966"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_y" value="0.095"/>
  <xacro:property name="wheel_x_front" value="0.0615"/>
  <xacro:property name="wheel_x_rear" value="-0.0615"/>
  <xacro:property name="chassis_x_min" value="-0.0925"/>
  <xacro:property name="chassis_x_max" value="0.1025"/>
  <xacro:property name="chassis_width" value="0.139"/>
  <xacro:property name="chassis_z_min" value="0.055"/>
  <xacro:property name="chassis_z_max" value="0.118"/>

  <!-- The CAD meshes, in millimetres. The cover plate keeps its assembly coordinates (x points
       backwards, y up): its top plate is centred on x 197.67 and z 67.67 mm, its top at y 63.16 mm.
       It is placed by eye, centred on the chassis box with its top on the box's top; its front
       slants down from x 70 mm, so the hull box under it ends there. The sensor plate
       (90 x 134 x 4 mm) has its origin at a corner and lies on the top, under the LiDAR. -->
  <xacro:property name="mm" value="0.001"/>
  <xacro:property name="cover_plate_cad_x_centre" value="0.19767"/>
  <xacro:property name="cover_plate_cad_z_centre" value="0.06767"/>
  <xacro:property name="cover_plate_cad_y_top" value="0.06316"/>
  <xacro:property name="cover_plate_width" value="0.134"/>
  <xacro:property name="plate_thickness" value="0.004"/>
  <xacro:property name="sensor_plate_length" value="0.090"/>
  <xacro:property name="sensor_plate_width" value="0.134"/>
  <xacro:property name="sensor_plate_top" value="${chassis_z_max + plate_thickness}"/>
  <xacro:property name="hull_x_max" value="0.070"/>

  <!-- Sensor frames, relative to base_footprint, all level. The LiDAR's yaw stays 0 until
       bring-up measures it; the IMU's place is a placeholder until it is mounted (#12). -->
  <xacro:property name="lidar_x" value="0.0295"/>
  <xacro:property name="lidar_y" value="-0.028"/>
  <xacro:property name="lidar_z" value="0.165"/>
  <xacro:property name="lidar_top" value="0.175"/>
  <xacro:property name="lidar_body_size" value="0.07"/>
  <xacro:property name="camera_case_size" value="0.025"/>
  <xacro:property name="imu_z" value="0.118"/>
  <xacro:property name="camera_x" value="0.1225"/>
  <xacro:property name="camera_z" value="0.080"/>

  <!-- Mass: 2.2 kg in all, centre of mass at x -0.010, z 0.070 above the floor. -->
  <xacro:property name="total_mass" value="2.2"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="com_x" value="-0.010"/>
  <xacro:property name="com_z" value="0.070"/>
  <xacro:property name="chassis_mass" value="${total_mass - 6 * wheel_mass}"/>

  <!-- Drive: the motor's no-load speed at the wheel; one side's stall torque over its 3 wheels.
       Without an effort limit, DART's velocity servo has infinite torque. -->
  <xacro:property name="wheel_velocity_limit" value="48.2"/>
  <xacro:property name="stall_torque_per_side" value="0.54"/>
  <xacro:property name="wheel_effort_limit" value="${stall_torque_per_side / 3}"/>

  <!-- Wheel-floor friction. DART ignores kp/kd. fdir1 is the wheel axle (the collision
       cylinder's z axis), so mu1 acts sideways and mu2 along the rolling direction. Turning on
       the spot skids and reaches about 85 % of the commanded turn rate; lowering mu1 down to 0.1
       did not change that in DART. Matching the real robot's turn rate is v0.2.0 work. -->
  <xacro:property name="wheel_mu_sideways" value="1.0"/>
  <xacro:property name="wheel_mu_rolling" value="1.0"/>

  <!-- Chassis box, and its centre of mass placed so the whole robot's lands at (com_x, com_z). -->
  <xacro:property name="chassis_length" value="${chassis_x_max - chassis_x_min}"/>
  <xacro:property name="chassis_height" value="${chassis_z_max - chassis_z_min}"/>
  <xacro:property name="chassis_x" value="${(chassis_x_max + chassis_x_min) / 2}"/>
  <xacro:property name="chassis_z" value="${(chassis_z_max + chassis_z_min) / 2 - base_link_z}"/>
  <xacro:property name="chassis_com_x" value="${total_mass * com_x / chassis_mass}"/>
  <xacro:property name="chassis_com_z"
    value="${(total_mass * com_z - 6 * wheel_mass * wheel_radius) / chassis_mass - base_link_z}"/>

  <!-- Visual colours, so Gazebo and RViz2 don't draw the boxes black. -->
  <material name="chassis">
    <color rgba="0.9 0.5 0.1 1"/>
  </material>
  <material name="wheel">
    <color rgba="0.15 0.15 0.15 1"/>
  </material>
  <material name="plate">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  <material name="sensor">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- The cover plate, turned from its CAD axes to x forward, z up. -->
    <visual>
      <origin
        xyz="${chassis_x + cover_plate_cad_x_centre} ${-cover_plate_cad_z_centre}
          ${chassis_z_max - cover_plate_cad_y_top - base_link_z}"
        rpy="${pi / 2} 0 ${pi}"/>
      <geometry>
        <mesh filename="package://stubentiger_description/meshes/cover_plate.stl"
          scale="${mm} ${mm} ${mm}"/>
      </geometry>
      <material name="chassis"/>
    </visual>
    <!-- The hull under the cover plate, kept inside it and behind its slanted front. -->
    <visual>
      <origin xyz="${(chassis_x_min + hull_x_max) / 2} 0 ${chassis_z - plate_thickness / 2}"
        rpy="0 0 0"/>
      <geometry>
        <box size="${hull_x_max - chassis_x_min} ${cover_plate_width - 2 * plate_thickness}
          ${chassis_height - plate_thickness}"/>
      </geometry>
      <material name="plate"/>
    </visual>
    <visual>
      <origin
        xyz="${lidar_x - sensor_plate_length / 2} ${-sensor_plate_width / 2}
          ${chassis_z_max - base_link_z}"
        rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://stubentiger_description/meshes/sensor_plate.stl"
          scale="${mm} ${mm} ${mm}"/>
      </geometry>
      <material name="plate"/>
    </visual>
    <collision>
      <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${chassis_com_x} 0 ${chassis_com_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass * (chassis_width**2 + chassis_height**2) / 12}" ixy="0" ixz="0"
        iyy="${chassis_mass * (chassis_length**2 + chassis_height**2) / 12}" iyz="0"
        izz="${chassis_mass * (chassis_length**2 + chassis_width**2) / 12}"/>
    </inertial>
  </link>

  <!-- Sensor frames (REP-105), with boxes for the sensors' bodies. -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z - base_link_z}" rpy="0 0 0"/>
  </joint>
  <!-- The RPLIDAR A1 body, from the sensor plate up to the LiDAR's top. -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 ${(lidar_top + sensor_plate_top) / 2 - lidar_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${lidar_body_size} ${lidar_body_size} ${lidar_top - sensor_plate_top}"/>
      </geometry>
      <material name="sensor"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${imu_z - base_link_z}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z - base_link_z}" rpy="0 0 0"/>
  </joint>
  <!-- The camera case, behind its lens. -->
  <link name="camera_link">
    <visual>
      <origin xyz="${-camera_case_size / 2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_case_size} ${camera_case_size} ${camera_case_size}"/>
      </geometry>
      <material name="sensor"/>
    </visual>
  </link>

  <!-- The camera's optical frame (REP-103): z forward, x right, y down. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>
  <link name="camera_optical_link"/>

  <!-- One floor wheel; mimic is the commanded joint it follows, or empty for a commanded one. -->
  <xacro:macro name="floor_wheel" params="name x y mimic">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_radius - base_link_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>
      <xacro:if value="${mimic != ''}">
        <mimic joint="${mimic}" multiplier="1" offset="0"/>
      </xacro:if>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}" ixy="0" ixz="0"
          iyy="${wheel_mass * wheel_radius**2 / 2}" iyz="0"
          izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}"/>
      </inertial>
    </link>

    <gazebo reference="${name}_link">
      <mu1>${wheel_mu_sideways}</mu1>
      <mu2>${wheel_mu_rolling}</mu2>
      <fdir1>0 0 1</fdir1>
    </gazebo>
  </xacro:macro>

  <!-- Middle wheel commanded; _2 in front of it, _3 behind it. -->
  <xacro:macro name="track" params="side y">
    <xacro:floor_wheel name="${side}_wheel" x="0" y="${y}" mimic=""/>
    <xacro:floor_wheel name="${side}_wheel_2" x="${wheel_x_front}" y="${y}"
      mimic="${side}_wheel_joint"/>
    <xacro:floor_wheel name="${side}_wheel_3" x="${wheel_x_rear}" y="${y}"
      mimic="${side}_wheel_joint"/>
  </xacro:macro>

  <xacro:track side="left" y="${wheel_y}"/>
  <xacro:track side="right" y="${-wheel_y}"/>

  <xacro:stubentiger_ros2_control hardware="${hardware}"
    serial_port="$(arg serial_port)" counts_per_rev="$(arg counts_per_rev)"/>

  <!-- The body's true pose in the world, on Gazebo's /model/stubentiger/pose. Tests judge
       driving on it, never on /odom, which would hide wheel slip. -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>100</update_frequency>
    </plugin>
  </gazebo>

  <xacro:if value="$(arg sensors)">
    <xacro:include filename="stubentiger.sensors.xacro"/>
  </xacro:if>

  <xacro:if value="${hardware == 'gazebo' and '$(arg controllers_file)' != ''}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
